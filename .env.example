# ---------------------------------------------------------------------------
# ORBIS environment configuration
# Copy this file to .env.local and fill in values as needed.
# All variables are OPTIONAL. ORBIS runs locally without any of them.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- AI summarization (optional) -------------------------------------------
# ORBIS works without AI. When no provider is configured it produces
# deterministic basic summaries and labels them as such in the UI.
#
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, OpenRouter,
# Groq, a local Ollama/LM Studio server, etc.)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...                      # server-side only; never exposed to the browser
# AI_MODEL=gpt-4o-mini

# --- Ingestion -------------------------------------------------------------
# Token required to call POST /api/ingest (manual / scheduled ingestion trigger).
# If unset, the endpoint is disabled. Lazy background refresh of data still works.
# INGEST_TOKEN=change-me-to-a-long-random-string

# --- Data source toggles (optional) ----------------------------------------
# Individual sources can be disabled with ORBIS_SOURCE_<ID>_DISABLED=1
# (see src/lib/sources/registry.ts for source IDs).

# --- Map tiles (optional) --------------------------------------------------
# Default basemap is OpenFreeMap vector tiles (free, keyless; the style follows
# ORBIS's light/dark theme). Set this only if you want a raster tile provider
# of your own — it is rendered as a minimal raster style instead.
# ORBIS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# ORBIS_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- Local port (optional) -------------------------------------------------
# Dev server port is chosen with `next dev -p <port>`; 3000 is used by default.
# If 3000 is occupied use e.g. `npm run dev -- -p 3001`.

# --- Live vessel layer (optional) ------------------------------------------
# Live AIS vessel positions on the World Map. AISStream.io is free but requires
# a key (https://aisstream.io). Without a key the map still shows the maritime
# reference layer (watch-area outline, major straits) plus clearly-labelled demo
# positions — never presented as live data. Server-side only; the key never
# reaches the browser.
# AISSTREAM_API_KEY=...
# Watch area as a JSON array of [[south, west], [north, east]] boxes.
# Defaults to the Gulf / Red Sea corridor. Vessels outside it are not collected.
# ORBIS_AIS_BOXES=[[[12,32],[30.5,57.5]]]
# Optional reference list of MMSIs known to be naval hulls — those get a violet
# "listed naval hull" badge (heuristic orange badges appear automatically from
# ship-name prefixes). Comma-separated or JSON array of 9-digit MMSIs.
# AIS has no vessel-class field and military ships often don't transmit AIS:
# badges are never proof, and absence means nothing.
# ORBIS_AIS_NAVAL_MMSIS=249123456,254123456
